---
import { getProjets, getCategories, getClients, imageUrl } from '../lib/directus.js';

const [projetsRaw, categories, clients] = await Promise.all([getProjets(), getCategories(), getClients()]);
const base = import.meta.env.BASE_URL;

const getSpan = (poids) => {
  const p = Number(poids);
  if (p >= 4) return 8;
  if (p === 3) return 6;
  if (p === 2) return 4;
  return 3;
};

const colSpan = (poids) => `span-${getSpan(poids)}`;

const PALETTE = ['#1CC9FE', '#0D667F', '#7D8893'];
let _tileColor1 = -1, _tileColor2 = -1; // deux dernières couleurs (récente = _tileColor1)
const makeTile = (span) => {
  let idx;
  do {
    idx = Math.floor(Math.random() * PALETTE.length);
  } while (idx === _tileColor1 || (PALETTE.length > 2 && idx === _tileColor2));
  _tileColor2 = _tileColor1;
  _tileColor1 = idx;
  return { _tile: true, color: PALETTE[idx], _span: span };
};
const itemSpanClass = (item) => item._tile ? `span-${item._span}` : item._heroSpan ? `span-${item._heroSpan}` : colSpan(item.poids);

function findInWindow(pool, targetSpan, lookahead) {
  const limit = Math.min(lookahead, pool.length);
  for (let j = 0; j < limit; j++) {
    if (getSpan(pool[j].poids) === targetSpan) return j;
  }
  return -1;
}

function mosaicLayout(items, lookahead = 8) {
  const pool = [...items];
  const result = [];
  let blockCount = 0;
  let gapStreak = 0;
  let alternateReverse = false;

  while (pool.length > 0) {
    blockCount++;
    const firstSpan = getSpan(pool[0].poids);

    if (firstSpan === 8) {
      if (alternateReverse) {
        // Bloc inversé : 2 tuiles span-2×2 à gauche, photo span-8 à droite.
        const t1 = makeTile(2); t1._row2 = true;
        const t2 = makeTile(2); t2._row2 = true;
        result.push(t1);
        result.push(t2);
        result.push(pool.shift());
      } else {
        // Bloc normal : photo span-8 à gauche, 2 companions span-4 à droite.
        result.push(pool.shift());
        let tilesUsed = 0;
        for (let side = 0; side < 2; side++) {
          const ahead = tilesUsed > 0 ? pool.length : lookahead;
          const idx = findInWindow(pool, 4, ahead);
          if (idx !== -1) { result.push(pool.splice(idx, 1)[0]); }
          else { result.push(makeTile(4)); tilesUsed++; }
        }
      }
      alternateReverse = !alternateReverse;
      gapStreak = 0;
    } else {
      let rowSpace = 12;
      const hasRhythm = (blockCount % 5 === 0);
      if (hasRhythm) { rowSpace -= 2; gapStreak = 0; }

      const rowStart = result.length;
      while (rowSpace > 0 && pool.length > 0) {
        const limit = Math.min(lookahead, pool.length);
        let picked = false;
        for (let j = 0; j < limit; j++) {
          const s = getSpan(pool[j].poids);
          // Ne jamais placer un span-8 en milieu de rangée (décalé de la colonne 1).
          if (s <= rowSpace && !(s === 8 && rowSpace < 12)) {
            const [item] = pool.splice(j, 1);
            result.push(item);
            rowSpace -= s;
            picked = true;
            break;
          }
        }
        if (!picked) break;
      }

      // Tuile de rythme : position aléatoire dans la rangée.
      if (hasRhythm) {
        const at = rowStart + Math.floor(Math.random() * (result.length - rowStart + 1));
        result.splice(at, 0, makeTile(2));
      }

      // Tuile de gap : position aléatoire, max 1 rangée consécutive, pas si tuile de rythme.
      if (!hasRhythm && (rowSpace === 1 || rowSpace === 2) && gapStreak < 1) {
        const at = rowStart + Math.floor(Math.random() * (result.length - rowStart + 1));
        result.splice(at, 0, makeTile(rowSpace));
        gapStreak++;
      } else if (!hasRhythm) {
        gapStreak = 0;
      }

      if (pool.length === 0 && rowSpace > 2) {
        let lastProj = null;
        for (let li = result.length - 1; li >= 0; li--) {
          if (!result[li]._tile) { lastProj = result[li]; break; }
        }
        if (lastProj && rowSpace >= 8 && getSpan(lastProj.poids) <= 4) {
          lastProj._heroSpan = 8;
          lastProj._heroRow2 = true;
          result.push(makeTile(4));
          result.push(makeTile(4));
        } else {
          result.push(makeTile(rowSpace));
        }
      }

      if (result.length === rowStart && pool.length > 0) result.push(pool.shift());
    }
  }

  return result;
}

const layoutResult = mosaicLayout(projetsRaw);

// Injecte un séparateur d'année au début de chaque rangée quand l'année change
const projets = [];
let rowPos = 0;
let currentYear = null;
for (const item of layoutResult) {
  const span = item._tile ? item._span : (item._heroSpan || getSpan(item.poids));
  if (!item._tile && rowPos === 0) {
    const yr = Number(item.annee);
    if (yr !== currentYear) {
      projets.push({ _separator: true, annee: yr });
      currentYear = yr;
    }
  }
  projets.push(item);
  rowPos = (rowPos + span) % 12;
}
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>1·2·7·8 réalisation(s)</title>
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml">
  <link rel="icon" href={`${base}favicon.ico`} sizes="any">
  <link rel="stylesheet" href="https://use.typekit.net/deq5imu.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>

<nav>
  <a href={base} class="logo">
    <img src={`${base}logo.png`} class="logo-mark" alt="1·2·7·8 réalisation(s)" onerror="this.style.display='none';this.parentElement.querySelector('.logo-fallback').style.display='flex'">
    <span class="logo-fallback" style="display:none"><span class="logo-text">1<span class="accent">·</span>2<span class="accent">·</span>7<span class="accent">·</span>8</span><span class="logo-sub"> réalisation(s)</span></span>
  </a>
  <div class="links">
    <a href={base} class="active">Portfolio</a>
    <a href={`${base}flashback`}>Flashback</a>
    <a href={`${base}contact`}>Contact</a>
    <a href={`${base}en`}>EN</a>
  </div>
</nav>

<div class="filters">
  <a href="#" data-cat="" class="active">Tout afficher</a>
  {categories.map(cat => (
    <a href="#" data-cat={cat.slug}>{cat.nom}</a>
  ))}
</div>

<div class="grid">
  {projets.map(item => item._separator ? (
    <div class="year-sep">
      <span class="year-label">{item.annee}</span>
      {clients && clients.length > 0 && (
        <div class="sep-clients">
          <div class="sep-track">
            {[...clients, ...clients].map((c) => (
              c.logo
                ? <img src={imageUrl(c.logo, 120)} alt={c.nom} title={c.nom} />
                : <span>{c.nom}</span>
            ))}
          </div>
        </div>
      )}
    </div>
  ) : item._tile ? (
    <div class={`item tile server-tile ${itemSpanClass(item)}`} style={`background: ${item.color};${item._row2 ? ' grid-row: span 2;' : ''}`}></div>
  ) : (
    <a
      href={`${base}projets/${item.slug}`}
      class={`item ${itemSpanClass(item)}`}
      data-poids={item.poids}
      data-cats={item.categories?.map(c => c.portfolio_categories_id?.slug).filter(Boolean).join(',')}
      style={item._heroRow2 ? 'grid-row: span 2' : undefined}
    >
      {item.image_vignette && (
        <img
          src={imageUrl(item.image_vignette.id, 800)}
          alt={item.titre}
          loading="lazy"
        />
      )}
      <div class="overlay">
        <div class="info">
          <div class="titre">{item.titre}</div>
          <div class="meta">{item.annee}{item.diffusion ? ` · ${item.diffusion}` : ''}</div>
        </div>
      </div>
    </a>
  ))}
</div>

<footer>
  <span>1·2·7·8 réalisation(s)</span>
  <span>contact@1-2-7-8.tv · +33 (0)6 44 66 33 00</span>
</footer>

<script is:inline define:vars={{ BASE: import.meta.env.BASE_URL }}>
(function () {

  /* ── helpers identiques au mosaicLayout serveur ── */
  var PALETTE = ['#1CC9FE', '#0D667F', '#7D8893'];

  function getSpan(poids) {
    var p = Number(poids);
    if (p >= 4) return 8;
    if (p === 3) return 6;
    if (p === 2) return 4;
    return 3;
  }

  function findInWindow(pool, targetSpan, lookahead) {
    var limit = Math.min(lookahead, pool.length);
    for (var j = 0; j < limit; j++) {
      if (getSpan(pool[j].poids) === targetSpan) return j;
    }
    return -1;
  }

  function mosaicLayout(items, lookahead) {
    lookahead = lookahead || 8;
    var tileColor1 = -1, tileColor2 = -1;
    function mkTile(span) {
      var idx;
      do {
        idx = Math.floor(Math.random() * PALETTE.length);
      } while (idx === tileColor1 || (PALETTE.length > 2 && idx === tileColor2));
      tileColor2 = tileColor1;
      tileColor1 = idx;
      return { _tile: true, span: span, color: PALETTE[idx] };
    }
    var pool = items.slice();
    var result = [];
    var blockCount = 0;
    var gapStreak = 0;
    var alternateReverse = false;

    while (pool.length > 0) {
      blockCount++;
      var firstSpan = getSpan(pool[0].poids);

      if (firstSpan === 8) {
        if (alternateReverse) {
          var t1 = mkTile(2); t1._row2 = true;
          var t2 = mkTile(2); t2._row2 = true;
          result.push(t1);
          result.push(t2);
          result.push(pool.shift());
        } else {
          result.push(pool.shift());
          var tilesUsed = 0;
          for (var side = 0; side < 2; side++) {
            var ahead = tilesUsed > 0 ? pool.length : lookahead;
            var idx = findInWindow(pool, 4, ahead);
            if (idx !== -1) { result.push(pool.splice(idx, 1)[0]); }
            else { result.push(mkTile(4)); tilesUsed++; }
          }
        }
        alternateReverse = !alternateReverse;
        gapStreak = 0;
      } else {
        var rowSpace = 12;
        var hasRhythm = (blockCount % 5 === 0);
        if (hasRhythm) { rowSpace -= 2; gapStreak = 0; }
        var rowStart = result.length;
        while (rowSpace > 0 && pool.length > 0) {
          var limit = Math.min(lookahead, pool.length);
          var picked = false;
          for (var j = 0; j < limit; j++) {
            var s = getSpan(pool[j].poids);
            if (s <= rowSpace && !(s === 8 && rowSpace < 12)) {
              result.push(pool.splice(j, 1)[0]);
              rowSpace -= s;
              picked = true;
              break;
            }
          }
          if (!picked) break;
        }
        if (hasRhythm) {
          var at = rowStart + Math.floor(Math.random() * (result.length - rowStart + 1));
          result.splice(at, 0, mkTile(2));
        }
        if (!hasRhythm && (rowSpace === 1 || rowSpace === 2) && gapStreak < 1) {
          var at = rowStart + Math.floor(Math.random() * (result.length - rowStart + 1));
          result.splice(at, 0, mkTile(rowSpace));
          gapStreak++;
        } else if (!hasRhythm) {
          gapStreak = 0;
        }
        if (pool.length === 0 && rowSpace > 2) {
          var lp = null;
          for (var lpi = result.length - 1; lpi >= 0; lpi--) {
            if (!result[lpi]._tile) { lp = result[lpi]; break; }
          }
          if (lp && rowSpace >= 8 && getSpan(lp.poids) <= 4) {
            lp._heroSpan = 8;
            lp._heroRow2 = true;
            result.push(mkTile(4));
            result.push(mkTile(4));
          } else {
            result.push(mkTile(rowSpace));
          }
        }
        if (result.length === rowStart && pool.length > 0) result.push(pool.shift());
      }
    }
    return result;
  }

  /* ── DOM ── */
  var grid = document.querySelector('.grid');
  var filterBtns = document.querySelectorAll('.filters a[data-cat]');

  function projectItems() {
    return Array.prototype.slice.call(grid.querySelectorAll('.item:not(.tile)'));
  }

  function removeClientTiles() {
    grid.querySelectorAll('.client-tile').forEach(function(t) { t.remove(); });
  }

  function applyLayout(items) {
    removeClientTiles();
    /* reset ordre + visibilité sur tous les projets */
    projectItems().forEach(function(el) {
      el.style.order = '';
      el.style.display = 'none';
      el.style.gridColumn = '';
      el.style.gridRow = '';
    });
    var layout = mosaicLayout(items.map(function(el) {
      return { poids: el.dataset.poids, el: el };
    }));
    layout.forEach(function(entry, i) {
      if (entry._tile) {
        var tile = document.createElement('div');
        tile.className = 'item tile client-tile span-' + entry.span;
        tile.style.cssText = 'background:' + entry.color + ';order:' + i;
        if (entry._row2) tile.style.gridRow = 'span 2';
        grid.appendChild(tile);
      } else {
        entry.el.style.display = '';
        entry.el.style.order = i;
        if (entry._heroSpan) {
          entry.el.style.gridColumn = 'span ' + entry._heroSpan;
          entry.el.style.gridRow = 'span 2';
        }
      }
    });
  }

  function restoreServerLayout() {
    removeClientTiles();
    projectItems().forEach(function(el) {
      el.style.display = '';
      el.style.order = '';
      el.style.gridColumn = '';
      el.style.gridRow = '';
    });
    grid.querySelectorAll('.server-tile').forEach(function(t) {
      t.style.display = '';
      t.style.order = '';
    });
  }

  var _filterTimer = null;
  var _cleanupTimer = null;

  function cancelPending() {
    if (_filterTimer)  { clearTimeout(_filterTimer);  _filterTimer  = null; }
    if (_cleanupTimer) { clearTimeout(_cleanupTimer); _cleanupTimer = null; }
    projectItems().forEach(function(el) {
      el.style.transition = 'none'; el.style.opacity = '';
    });
    grid.querySelectorAll('.client-tile, .server-tile').forEach(function(t) {
      t.style.transition = 'none'; t.style.opacity = '';
    });
  }

  function applyFilter(cat, animate) {
    filterBtns.forEach(function(btn) {
      btn.classList.toggle('active', btn.getAttribute('data-cat') === cat);
    });

    if (!animate) {
      if (cat === '') { restoreServerLayout(); }
      else {
        grid.querySelectorAll('.server-tile').forEach(function(t) { t.style.display = 'none'; });
        applyLayout(projectItems().filter(function(el) {
          return (el.getAttribute('data-cats') || '').split(',').indexOf(cat) !== -1;
        }));
      }
      history.pushState({ cat: cat }, '', cat ? BASE + '?cat=' + cat : BASE);
      return;
    }

    cancelPending();

    var allProjects = projectItems();
    var nextVisible = cat === '' ? allProjects : allProjects.filter(function(el) {
      return (el.getAttribute('data-cats') || '').split(',').indexOf(cat) !== -1;
    });

    var FADE = 280, FADE_IN = 600, STAGGER = 40, MAX_SPREAD = 360;

    function byPosition(els) {
      return els.map(function(el) {
        var r = el.getBoundingClientRect();
        return { el: el, top: r.top, left: r.left };
      }).sort(function(a, b) {
        return a.top !== b.top ? a.top - b.top : a.left - b.left;
      });
    }

    /* ── Phase 1 : tout disparaît en cascade ── */
    var fadeOutEls = allProjects.filter(function(el) { return el.style.display !== 'none'; });
    grid.querySelectorAll('.client-tile, .server-tile').forEach(function(t) {
      if (t.style.display !== 'none') fadeOutEls.push(t);
    });
    var outSorted = byPosition(fadeOutEls);
    var nOut = outSorted.length;
    var outSpread = nOut > 1 ? Math.min((nOut - 1) * STAGGER, MAX_SPREAD) : 0;
    outSorted.forEach(function(item, i) {
      var d = nOut > 1 ? Math.round(i / (nOut - 1) * outSpread) : 0;
      item.el.style.transition = 'opacity ' + FADE + 'ms ' + d + 'ms';
      item.el.style.opacity = '0';
    });

    /* ── Phase 2 : layout, quand tout est invisible ── */
    _filterTimer = setTimeout(function() {
      _filterTimer = null;

      if (cat === '') { restoreServerLayout(); }
      else {
        grid.querySelectorAll('.server-tile').forEach(function(t) { t.style.display = 'none'; });
        applyLayout(nextVisible);
      }
      /* Les projets nextVisible gardent leur opacity:0 hérité de la Phase 1.
         On stoppe seulement le fondu sortant en vidant la transition. */
      allProjects.forEach(function(el) { el.style.transition = ''; });

      /* Les nouvelles tuiles n'ont pas d'opacity inline → forcer 0 avant reflow */
      grid.querySelectorAll('.client-tile').forEach(function(t) {
        t.style.opacity = '0'; t.style.transition = '';
      });
      if (cat === '') {
        grid.querySelectorAll('.server-tile').forEach(function(t) {
          if (t.style.display !== 'none') { t.style.opacity = '0'; t.style.transition = ''; }
        });
      }

      /* ── Phase 3 : tout réapparaît en cascade ── */
      /* byPosition() force un reflow → valide opacity:0 comme état "from" pour les transitions */
      var fadeInEls = nextVisible.filter(function(el) { return el.style.display !== 'none'; });
      grid.querySelectorAll('.client-tile').forEach(function(t) { fadeInEls.push(t); });
      if (cat === '') {
        grid.querySelectorAll('.server-tile').forEach(function(t) {
          if (t.style.display !== 'none') fadeInEls.push(t);
        });
      }
      var inSorted = byPosition(fadeInEls);
      var nIn = inSorted.length;
      var inSpread = nIn > 1 ? Math.min((nIn - 1) * STAGGER, MAX_SPREAD) : 0;
      inSorted.forEach(function(item, i) {
        var d = nIn > 1 ? Math.round(i / (nIn - 1) * inSpread) : 0;
        item.el.style.transition = 'opacity ' + FADE_IN + 'ms ' + d + 'ms';
        requestAnimationFrame(function() { item.el.style.opacity = '1'; });
      });

      /* nettoyage — buffer généreux pour couvrir délai rAF + marge */
      _cleanupTimer = setTimeout(function() {
        _cleanupTimer = null;
        allProjects.forEach(function(el) { el.style.transition = ''; el.style.opacity = ''; });
        grid.querySelectorAll('.client-tile, .server-tile').forEach(function(t) {
          t.style.transition = ''; t.style.opacity = '';
        });
      }, inSpread + FADE_IN + 150);

    }, outSpread + FADE + 10);

    history.pushState({ cat: cat }, '', cat ? BASE + '?cat=' + cat : BASE);
  }

  filterBtns.forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      applyFilter(btn.getAttribute('data-cat'), true);
    });
  });

  var initial = new URLSearchParams(location.search).get('cat') || '';
  if (initial) applyFilter(initial, false);

  window.addEventListener('popstate', function(e) {
    applyFilter((e.state && e.state.cat) || '', false);
  });

})();
</script>

</body>
</html>

<style is:global>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: #0a0a0a; color: #e8e8e0; font-family: 'Barlow Condensed', sans-serif; min-height: 100vh; display: flex; flex-direction: column; }
  .grid { flex: 1; }


  nav { display: flex; justify-content: space-between; align-items: center; padding: 16px 24px; border-bottom: 0.5px solid rgba(13,102,127,0.35); }
  .logo { font-size: 14px; font-weight: 700; letter-spacing: .08em; text-decoration: none; color: inherit; display: flex; align-items: center; gap: 8px; }
  .logo-mark { height: 28px; width: auto; }
  .logo-text { font-family: 'stenciletta-solid', 'Barlow Condensed', sans-serif; }
  .logo .accent { color: #1CC9FE; }
  .logo-sub { font-weight: 400; color: #7D8893; }
  nav .links { display: flex; gap: 20px; }
  nav a { font-size: 11px; color: #7D8893; text-decoration: none; letter-spacing: .1em; font-family: 'stenciletta-solid', 'Barlow Condensed', sans-serif; }
  nav a.active { color: #1CC9FE; }

  .filters { display: flex; gap: 6px; padding: 12px 24px; border-bottom: 0.5px solid rgba(255,255,255,0.05); flex-wrap: wrap; }
  .filters a { font-size: 10px; padding: 4px 10px; border: 0.5px solid #6D6E71; color: #7D8893; text-decoration: none; letter-spacing: .08em; }
  .filters a[data-cat=""] { color: #e8e8e0; border-color: rgba(255,255,255,0.3); margin-right: 6px; }
  .filters a.active { background: rgba(28,201,254,0.08); color: #1CC9FE; border-color: rgba(28,201,254,0.4); }
  .item.hidden { display: none; }

  .grid { display: grid; grid-template-columns: repeat(12, 1fr); grid-auto-rows: calc(100vw * 9 / 48); gap: 5px; padding: 5px; }
  .item { position: relative; overflow: hidden; cursor: pointer; background: #181818; border-radius: 10px; text-decoration: none; color: inherit; }
  .span-8 { grid-column: span 8; grid-row: span 2; }
  .span-6 { grid-column: span 6; }
  .span-4 { grid-column: span 4; }
  .span-3 { grid-column: span 3; }
  .span-2 { grid-column: span 2; }
  .span-1 { grid-column: span 1; }
  .item img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .item .overlay { position: absolute; inset: 0; background: rgba(0,0,0,0); transition: background .2s; display: flex; flex-direction: column; justify-content: flex-end; padding: 10px; }
  .item:hover .overlay { background: rgba(0,0,0,0.65); }
  .item .info { opacity: 0; transform: translateY(4px); transition: all .15s; }
  .item:hover .info { opacity: 1; transform: translateY(0); }
  .item .titre { font-size: 16px; font-weight: 700; color: #fff; font-family: 'stenciletta-solid', 'Barlow Condensed', sans-serif; }
  .item .meta { font-size: 11px; color: #7D8893; margin-top: 4px; }

  .year-sep { grid-column: 1 / -1; display: flex; align-items: center; gap: 20px; padding: 28px 4px 12px; border-top: 0.5px solid rgba(28,201,254,0.2); overflow: hidden; }
  .year-label { font-size: 28px; font-weight: 700; font-family: 'stenciletta-solid', 'Barlow Condensed', sans-serif; color: #1CC9FE; letter-spacing: .04em; flex-shrink: 0; }
  .sep-clients { overflow: hidden; flex: 1; mask-image: linear-gradient(to right, transparent, black 80px, black calc(100% - 80px), transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 80px, black calc(100% - 80px), transparent); }
  .sep-track { display: flex; gap: 36px; align-items: center; width: max-content; animation: scroll-clients 28s linear infinite; will-change: transform; }
  .sep-track img { height: 20px; width: auto; max-width: 100px; min-width: 30px; opacity: 0.5; transition: opacity .2s; flex-shrink: 0; }
  .sep-track img:hover { opacity: 0.9; }
  @keyframes scroll-clients { from { transform: translateX(0); } to { transform: translateX(-50%); } }

