---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, ui } from '../../lib/i18n';
import type { Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = ui[lang];
---

<BaseLayout lang={lang} title={`Contact · 1·2·7·8 réalisation(s)`} activePage="contact">

<main>
  <div class="contact-layout">

    <div class="title-col">
      <div class="page-title">
        <span class="title-left">Contact</span>
        <span class="title-right">Contact</span>
      </div>
      <div class="baseline" set:html={t.contact.baseline} />
    </div>

    <div class="links-col">
      <div class="contact-lines">
        <a href="tel:+33644663300" class="contact-line">
          <span class="label">{t.contact.phone}</span>
          <span class="value">+33 (0) 6 44 66 33 00</span>
        </a>
        <div class="contact-line contact-emails">
          <span class="label">{t.contact.email}</span>
          <a href="mailto:contact@1-2-7-8.tv" class="value">contact@1-2-7-8.tv</a>
          <a href="mailto:alexis@1-2-7-8.tv" class="value value-secondary">alexis@1-2-7-8.tv</a>
        </div>
        <a href="https://bsky.app/profile/1-2-7-8.pro" target="_blank" rel="noopener" class="contact-line">
          <span class="label">Bluesky</span>
          <span class="value">@1-2-7-8.pro</span>
        </a>
      </div>

      <div class="legal">
        <span>24 rue Armand Numès · Bât. A · 92600 Asnières-sur-Seine · France</span>
        <br>
        <span>SASU · capital 10 000 € · RCS 488 234 329 00040 Nanterre · APE 5912Z · TVA FR 89 488 234 329</span>
      </div>
    </div>

  </div>
</main>

</BaseLayout>

<style is:global>
  main { flex: 1; padding: 48px 24px; display: flex; align-items: flex-start; }

  .contact-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; width: 100%; align-items: start; }

  .title-col { display: flex; flex-direction: column; align-items: flex-start; padding-top: 4px; gap: 28px; }
  .page-title { position: relative; line-height: 0.9; }
  .title-left  { display: block; font-family: 'stenciletta-left',  'Barlow Condensed', sans-serif; font-size: clamp(72px, 10vw, 140px); font-weight: 700; letter-spacing: .02em; color: #1CC9FE; }
  .title-right { display: block; font-family: 'stenciletta-right', 'Barlow Condensed', sans-serif; font-size: clamp(72px, 10vw, 140px); font-weight: 700; letter-spacing: .02em; color: #7D8893; position: absolute; top: 0; left: 0; }

  .baseline { font-family: 'stenciletta-solid', 'Barlow Condensed', sans-serif; font-size: clamp(18px, 2vw, 26px); line-height: 1.35; letter-spacing: .02em; max-width: 560px; }
  .baseline .b1 { color: #1CC9FE; }
  .baseline .b2 { color: #4A7EA0; }
  .baseline .b3 { color: #91FBFE; }
  .baseline .bsep { color: #7D8893; }

  .links-col { display: flex; flex-direction: column; gap: 0; align-items: stretch; text-align: right; }
  .contact-lines { display: flex; flex-direction: column; }
  .contact-line { display: flex; flex-direction: column; gap: 5px; padding: 14px 12px 14px 0; border-bottom: 0.5px solid rgba(255,255,255,0.07); border-right: 2px solid transparent; text-decoration: none; color: inherit; transition: color .15s, border-color .15s; }
  .contact-line:first-child { border-top: 0.5px solid rgba(255,255,255,0.07); }
  .contact-line:hover { color: #1CC9FE; border-right-color: #1CC9FE; }
  .label { font-size: 9px; letter-spacing: .16em; color: #7D8893; text-transform: uppercase; }
  .value { font-size: 24px; font-weight: 700; letter-spacing: .01em; }
  .contact-emails { cursor: default; }
  .contact-emails:hover { color: inherit; border-right-color: transparent; }
  .contact-emails .value { text-decoration: none; color: inherit; transition: color .15s; display: block; }
  .contact-emails .value-secondary { color: #7D8893; font-weight: 400; }
  .contact-emails .value:hover { color: #1CC9FE; }

  .legal { margin-top: 32px; font-size: 12px; color: #555; line-height: 1.7; padding-right: 12px; }

  @media (max-width: 768px) {
    .contact-layout { grid-template-columns: 1fr; gap: 32px; }
    .title-left, .title-right { font-size: clamp(56px, 18vw, 96px); }
    .links-col { text-align: left; }
    .contact-line { padding: 14px 0 14px 12px; border-right: 0; border-left: 2px solid transparent; }
    .contact-line:hover { border-right-color: transparent; border-left-color: #1CC9FE; }
    .contact-emails:hover { border-left-color: transparent; }
    .legal { padding-right: 0; padding-left: 12px; }
  }

  @media (max-width: 640px) {
    main { padding: 32px 16px; }
    .value { font-size: 20px; }
  }
</style>
