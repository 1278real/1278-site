---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { languages, ui } from '../../../lib/i18n';
import type { Lang } from '../../../lib/i18n';
import { getProjets, getProjet, imageUrl } from '../../../lib/directus.js';

export async function getStaticPaths() {
  const projets = await getProjets();
  return languages.flatMap(lang =>
    projets.map(p => ({ params: { lang, slug: p.slug } }))
  );
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const t = ui[lang];
const projet = await getProjet(slug);
const base = import.meta.env.BASE_URL;

if (!projet) return Astro.redirect(`${base}${lang}/`);

const titre = lang === 'en' && projet.titre_en ? projet.titre_en : projet.titre;
const description = lang === 'en' && projet.description_en ? projet.description_en : projet.description;

const getImageId = (img) => img?.directus_files_id?.id || img?.directus_files_id || img?.id || null;

const getYoutubeId = (url: string) => {
  if (!url) return null;
  const m = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([A-Za-z0-9_-]{11})/);
  return m ? m[1] : null;
};
const youtubeId = getYoutubeId(projet.url_youtube);
---

<BaseLayout
  lang={lang}
  title={`${titre} · 1·2·7·8 réalisation(s)`}
  activePage="portfolio"
  ogImage={projet.image_vignette ? imageUrl(projet.image_vignette.id, 1200) : undefined}
  ogDescription={description ? description.replace(/<[^>]*>/g, '').slice(0, 200) : undefined}
>

<div class="projet-header">
  <a href={`${base}${lang}/`} class="back">{t.projet.back}</a>
  <div class="projet-info">
    <h1>{titre}</h1>
    {projet.production && (
      <div class="production-line">{projet.production}</div>
    )}
    <div class="meta-line">
      {projet.annee && <span>{projet.annee}</span>}
      {projet.diffusion && <><span class="sep">·</span><span>{projet.diffusion}</span></>}
    </div>
    {projet.categories && projet.categories.length > 0 && (
      <div class="badges">
        {projet.categories.map(c => {
          const cat = c.portfolio_categories_id;
          return cat ? (
            <span class="badge" style={`color:${cat.couleur || '#7D8893'};border-color:${cat.couleur || '#7D8893'}`}>{cat.nom}</span>
          ) : null;
        })}
      </div>
    )}
  </div>
</div>

{projet.image_vignette && (
  <div class="hero">
    <img src={imageUrl(projet.image_vignette.id, 1920)} alt={titre} />
  </div>
)}

{description && (
  <div class="description">
    {projet.production && <p class="prod-prefix">Prod : <strong>{projet.production}</strong></p>}
    <div set:html={description} />
  </div>
)}

{(youtubeId || (projet.images && projet.images.length > 0)) && (
  <div class="gallery">
    {youtubeId && (
      <div class="gallery-video">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
          title={titre}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    )}
    {projet.images && projet.images.map(img => {
      const fileId = getImageId(img);
      return fileId ? (
        <img src={imageUrl(fileId, 1200)} alt="" loading="lazy" />
      ) : null;
    })}
  </div>
)}

</BaseLayout>

<style is:global>
  .projet-header { padding: 24px 24px 0; display: flex; gap: 32px; align-items: flex-start; }
  .back { font-size: 11px; color: #7D8893; text-decoration: none; letter-spacing: .1em; padding-top: 6px; white-space: nowrap; transition: color .15s; }
  .back:hover { color: #1CC9FE; }

  h1 { font-size: 42px; font-weight: 700; letter-spacing: .02em; line-height: 1; font-family: 'stenciletta-solid', 'Barlow Condensed', sans-serif; }
  .production-line { font-size: 13px; color: #1CC9FE; letter-spacing: .08em; margin-top: 8px; font-weight: 700; text-transform: uppercase; }
  .prod-prefix { font-size: 13px; color: #7D8893; letter-spacing: .06em; margin-bottom: 12px; }
  .prod-prefix strong { color: #1CC9FE; font-weight: 700; }
  .meta-line { font-size: 12px; color: #7D8893; margin-top: 6px; display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
  .meta-line .sep { color: #1CC9FE; }
  .badges { display: flex; gap: 6px; margin-top: 10px; flex-wrap: wrap; }
  .badge { font-size: 10px; padding: 4px 10px; border: 1px solid; letter-spacing: .08em; }

  .hero { width: 100%; height: 70vh; overflow: hidden; margin-top: 20px; }
  .hero img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .description { padding: 32px 24px; max-width: 720px; font-size: 16px; line-height: 1.65; }

  .gallery { display: grid; grid-template-columns: repeat(2, 1fr); gap: 5px; padding: 5px; padding-bottom: 20px; }
  .gallery-video { grid-column: span 2; position: relative; aspect-ratio: 16/9; overflow: hidden; border-radius: 6px; }
  .gallery-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: none; }
  .gallery img { width: 100%; display: block; object-fit: cover; }

  @media (max-width: 640px) {
    .projet-header { flex-direction: column; gap: 12px; padding: 16px 16px 0; }
    h1 { font-size: 28px; }
    .hero { height: 56vw; margin-top: 12px; }
    .description { padding: 20px 16px; font-size: 15px; }
    .gallery { grid-template-columns: 1fr; }
  }
</style>
