---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, ui } from '../../lib/i18n';
import type { Lang } from '../../lib/i18n';
import { getProjets, getCategories, getClients, imageUrl } from '../../lib/directus.js';

export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = ui[lang];

const [projetsRaw, categories, clients] = await Promise.all([getProjets(), getCategories(), getClients()]);
const base = import.meta.env.BASE_URL;

const tickerCount = clients && clients.length > 0
  ? Math.max(2, 2 * Math.ceil(40 / clients.length))
  : 2;
const tickerArr = clients ? Array.from({ length: tickerCount }, () => clients).flat() : [];
const tickerDurationS = 14 * tickerCount;

const getSpan = (poids) => {
  const p = Number(poids);
  if (p >= 4) return 8;
  if (p === 3) return 6;
  if (p === 2) return 4;
  return 3;
};

const colSpan = (poids) => `span-${getSpan(poids)}`;

const PALETTE = ['#1CC9FE', '#0D667F', '#4A7EA0', '#91FBFE', '#6D6E71', '#7D8893', '#D1D2D4'];
let _tileColor1 = -1, _tileColor2 = -1;
const makeTile = (span) => {
  let idx;
  do {
    idx = Math.floor(Math.random() * PALETTE.length);
  } while (idx === _tileColor1 || (PALETTE.length > 2 && idx === _tileColor2));
  _tileColor2 = _tileColor1;
  _tileColor1 = idx;
  return { _tile: true, color: PALETTE[idx], _span: span };
};
const itemSpanClass = (item) => item._tile ? `span-${item._span}` : item._heroSpan ? `span-${item._heroSpan}` : colSpan(item.poids);

function splitGap(space: number) {
  const tiles = [];
  let rem = space;
  while (rem > 0) {
    if (rem === 5)       { tiles.push(3, 2); rem = 0; }
    else if (rem === 7)  { tiles.push(4, 3); rem = 0; }
    else if (rem === 11) { tiles.push(6, 3, 2); rem = 0; }
    else if (rem >= 6)   { tiles.push(6); rem -= 6; }
    else if (rem >= 4)   { tiles.push(4); rem -= 4; }
    else if (rem >= 3)   { tiles.push(3); rem -= 3; }
    else if (rem >= 2)   { tiles.push(2); rem -= 2; }
    else                 { tiles.push(1); rem -= 1; }
  }
  return tiles;
}

function findInWindow(pool, targetSpan, lookahead) {
  const limit = Math.min(lookahead, pool.length);
  for (let j = 0; j < limit; j++) {
    if (getSpan(pool[j].poids) === targetSpan) return j;
  }
  return -1;
}

function mosaicLayout(items, lookahead = 8) {
  const pool = [...items];
  const result: any[] = [];
  let blockCount = 0;
  let alternateReverse = false;

  while (pool.length > 0) {
    blockCount++;
    const firstSpan = getSpan(pool[0].poids);

    if (firstSpan === 8) {
      if (alternateReverse) {
        const t1 = makeTile(2); t1._row2 = true;
        const t2 = makeTile(2); t2._row2 = true;
        result.push(t1);
        result.push(t2);
        result.push(pool.shift());
      } else {
        result.push(pool.shift());
        let tilesUsed = 0;
        for (let side = 0; side < 2; side++) {
          const ahead = tilesUsed > 0 ? pool.length : lookahead;
          const idx = findInWindow(pool, 4, ahead);
          if (idx !== -1) { result.push(pool.splice(idx, 1)[0]); }
          else { result.push(makeTile(4)); tilesUsed++; }
        }
      }
      alternateReverse = !alternateReverse;
    } else {
      let rowSpace = 12;
      const hasRhythm = (blockCount % 5 === 0);
      if (hasRhythm) { rowSpace -= 2; }

      const rowStart = result.length;
      while (rowSpace > 0 && pool.length > 0) {
        const limit = Math.min(lookahead, pool.length);
        let picked = false;
        for (let j = 0; j < limit; j++) {
          const s = getSpan(pool[j].poids);
          if (s <= rowSpace && !(s === 8 && rowSpace < 12)) {
            const [item] = pool.splice(j, 1);
            result.push(item);
            rowSpace -= s;
            picked = true;
            break;
          }
        }
        if (!picked) break;
      }

      if (hasRhythm) {
        const at = rowStart + Math.floor(Math.random() * (result.length - rowStart + 1));
        result.splice(at, 0, makeTile(2));
      }

      if (!hasRhythm && rowSpace > 0 && pool.length > 0) {
        const at = rowStart + Math.floor(Math.random() * (result.length - rowStart + 1));
        splitGap(rowSpace).forEach((s, i) => result.splice(at + i, 0, makeTile(s)));
      }

      if (pool.length === 0 && rowSpace > 0) {
        let lastProj = null;
        for (let li = result.length - 1; li >= 0; li--) {
          if (!result[li]._tile) { lastProj = result[li]; break; }
        }
        if (lastProj && rowSpace >= 8 && getSpan((lastProj as any).poids) <= 4) {
          (lastProj as any)._heroSpan = 8;
          (lastProj as any)._heroRow2 = true;
          result.push(makeTile(4));
          result.push(makeTile(4));
        } else {
          splitGap(rowSpace).forEach(s => result.push(makeTile(s)));
        }
      }

      if (result.length === rowStart && pool.length > 0) result.push(pool.shift());
    }
  }

  return result;
}

const yearMap = new Map();
for (const p of projetsRaw) {
  const yr = Number(p.annee);
  if (!yearMap.has(yr)) yearMap.set(yr, []);
  yearMap.get(yr).push(p);
}
const yearGroups = [...yearMap.keys()]
  .sort((a, b) => b - a)
  .map(yr => ({ annee: yr, items: mosaicLayout(yearMap.get(yr)) }));

const selectionCat = categories.find(c => c.slug === 'selection');
const otherCats = categories.filter(c => c.slug !== 'selection').sort((a, b) => (a.ordre ?? 999) - (b.ordre ?? 999));
---

<BaseLayout lang={lang} title="1·2·7·8 réalisation(s)" activePage="portfolio">

<div class="filters">
  {selectionCat && (
    <a href="#" data-cat="selection">{t.categories['selection'] || selectionCat.nom}</a>
  )}
  <a href="#" data-cat="" class="active">{t.portfolio.showAll}</a>
  {otherCats.map(cat => (
    <a href="#" data-cat={cat.slug} class:list={[{ dim: !cat.highlight }]}>{t.categories[cat.slug] || cat.nom}</a>
  ))}
</div>

<div class="portfolio-wrapper">
  {clients && clients.length > 0 && (
    <div class="global-clients">
      <div class="sep-track" style={`animation-duration: ${tickerDurationS}s`}>
        {tickerArr.map((c) => (
          c.logo
            ? <img src={imageUrl(c.logo, 120)} alt={c.nom} title={c.nom} loading="lazy" decoding="async" />
            : <span>{c.nom}</span>
        ))}
      </div>
    </div>
  )}
  <div class="selection-flat-wrapper">
    <div class="grid selection-flat-grid"></div>
    {clients && clients.length > 0 && (
      <div class="global-clients global-clients-bottom">
        <div class="sep-track sep-track-reverse" style={`animation-duration: ${tickerDurationS}s`}>
          {tickerArr.map((c) => (
            c.logo
              ? <img src={imageUrl(c.logo, 120)} alt={c.nom} title={c.nom} loading="lazy" decoding="async" />
              : <span>{c.nom}</span>
          ))}
        </div>
      </div>
    )}
  </div>
  {yearGroups.map(group => (
    <div class="year-block" data-annee={group.annee}>
      <div class="year-sep">
        <div class="year-label">
          <span class="year-left">{group.annee}</span>
          <span class="year-right">{group.annee}</span>
        </div>
        {clients && clients.length > 0 && (
          <div class="sep-clients">
            <div class="sep-track" style={`animation-duration: ${tickerDurationS}s`}>
              {tickerArr.map((c) => (
                c.logo
                  ? <img src={imageUrl(c.logo, 120)} alt={c.nom} title={c.nom} loading="lazy" decoding="async" />
                  : <span>{c.nom}</span>
              ))}
            </div>
          </div>
        )}
      </div>
      <div class="grid">
        {group.items.map(item => item._tile ? (
          <div class={`item tile server-tile ${itemSpanClass(item)}`} style={`background: ${item.color};${item._row2 ? ' grid-row: span 2;' : ''}`}></div>
        ) : (
          <a
            href={`${base}${lang}/projets/${item.slug}`}
            class={`item ${itemSpanClass(item)}`}
            data-poids={item.poids}
            data-cats={item.categories?.map(c => c.portfolio_categories_id?.slug).filter(Boolean).join(',')}
            style={item._heroRow2 ? 'grid-row: span 2' : undefined}
          >
            {item.image_vignette && (
              <img src={imageUrl(item.image_vignette.id, 800)} alt={lang === 'en' && item.titre_en ? item.titre_en : item.titre} loading="lazy" decoding="async" />
            )}
            {item.video_vignette && (
              <video
                muted
                loop
                playsinline
                preload="none"
                disableRemotePlayback
                poster={item.image_vignette ? imageUrl(item.image_vignette.id, 800) : undefined}
                data-src={`https://api-gthp.1-2-7-8.solutions/assets/${item.video_vignette}`}
              ></video>
            )}
            <div class="overlay">
              <div class="info">
                <div class="titre">{lang === 'en' && item.titre_en ? item.titre_en : item.titre}</div>
                <div class="meta">{item.annee}{item.diffusion ? ` · ${item.diffusion}` : ''}</div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  ))}
</div>

<button id="back-top" aria-label="Retour en haut">↑</button>

<script is:inline define:vars={{ BASE: base, LANG: lang }}>
(function () {

  var PAGEBASE = BASE + LANG + '/';

  var PALETTE = ['#1CC9FE', '#0D667F', '#4A7EA0', '#91FBFE', '#6D6E71', '#7D8893', '#D1D2D4'];

  function getSpan(poids) {
    var p = Number(poids);
    if (p >= 4) return 8;
    if (p === 3) return 6;
    if (p === 2) return 4;
    return 3;
  }

  function findInWindow(pool, targetSpan, lookahead) {
    var limit = Math.min(lookahead, pool.length);
    for (var j = 0; j < limit; j++) {
      if (getSpan(pool[j].poids) === targetSpan) return j;
    }
    return -1;
  }

  function mosaicLayout(items, lookahead) {
    lookahead = lookahead || 8;
    var tileColor1 = -1, tileColor2 = -1;
    function mkTile(span) {
      var idx;
      do {
        idx = Math.floor(Math.random() * PALETTE.length);
      } while (idx === tileColor1 || (PALETTE.length > 2 && idx === tileColor2));
      tileColor2 = tileColor1;
      tileColor1 = idx;
      return { _tile: true, span: span, color: PALETTE[idx] };
    }
    function splitGap(space) {
      var tiles = [], rem = space;
      while (rem > 0) {
        if (rem === 5)       { tiles.push(3, 2); rem = 0; }
        else if (rem === 7)  { tiles.push(4, 3); rem = 0; }
        else if (rem === 11) { tiles.push(6, 3, 2); rem = 0; }
        else if (rem >= 6)   { tiles.push(6); rem -= 6; }
        else if (rem >= 4)   { tiles.push(4); rem -= 4; }
        else if (rem >= 3)   { tiles.push(3); rem -= 3; }
        else if (rem >= 2)   { tiles.push(2); rem -= 2; }
        else                 { tiles.push(1); rem -= 1; }
      }
      return tiles;
    }
    var pool = items.slice();
    var result = [];
    var blockCount = 0;
    var alternateReverse = false;

    while (pool.length > 0) {
      blockCount++;
      var firstSpan = getSpan(pool[0].poids);

      if (firstSpan === 8) {
        if (alternateReverse) {
          var t1 = mkTile(2); t1._row2 = true;
          var t2 = mkTile(2); t2._row2 = true;
          result.push(t1);
          result.push(t2);
          result.push(pool.shift());
        } else {
          result.push(pool.shift());
          var tilesUsed = 0;
          for (var side = 0; side < 2; side++) {
            var ahead = tilesUsed > 0 ? pool.length : lookahead;
            var idx = findInWindow(pool, 4, ahead);
            if (idx !== -1) { result.push(pool.splice(idx, 1)[0]); }
            else { result.push(mkTile(4)); tilesUsed++; }
          }
        }
        alternateReverse = !alternateReverse;
      } else {
        var rowSpace = 12;
        var hasRhythm = (blockCount % 5 === 0);
        if (hasRhythm) { rowSpace -= 2; }
        var rowStart = result.length;
        while (rowSpace > 0 && pool.length > 0) {
          var limit = Math.min(lookahead, pool.length);
          var picked = false;
          for (var j = 0; j < limit; j++) {
            var s = getSpan(pool[j].poids);
            if (s <= rowSpace && !(s === 8 && rowSpace < 12)) {
              result.push(pool.splice(j, 1)[0]);
              rowSpace -= s;
              picked = true;
              break;
            }
          }
          if (!picked) break;
        }
        if (hasRhythm) {
          var at = rowStart + Math.floor(Math.random() * (result.length - rowStart + 1));
          result.splice(at, 0, mkTile(2));
        }
        if (!hasRhythm && rowSpace > 0 && pool.length > 0) {
          var at = rowStart + Math.floor(Math.random() * (result.length - rowStart + 1));
          splitGap(rowSpace).forEach(function(s, i) { result.splice(at + i, 0, mkTile(s)); });
        }
        if (pool.length === 0 && rowSpace > 0) {
          var lp = null;
          for (var lpi = result.length - 1; lpi >= 0; lpi--) {
            if (!result[lpi]._tile) { lp = result[lpi]; break; }
          }
          if (lp && rowSpace >= 8 && getSpan(lp.poids) <= 4) {
            lp._heroSpan = 8;
            lp._heroRow2 = true;
            result.push(mkTile(4));
            result.push(mkTile(4));
          } else {
            splitGap(rowSpace).forEach(function(s) { result.push(mkTile(s)); });
          }
        }
        if (result.length === rowStart && pool.length > 0) result.push(pool.shift());
      }
    }
    return result;
  }

  var wrapper = document.querySelector('.portfolio-wrapper');
  var filterBtns = document.querySelectorAll('.filters a[data-cat]');

  function allYearBlocks() {
    return Array.prototype.slice.call(wrapper.querySelectorAll('.year-block'));
  }

  function projectItems() {
    return Array.prototype.slice.call(wrapper.querySelectorAll('.item:not(.tile)'));
  }

  function removeClientTiles(grid) {
    grid.querySelectorAll('.client-tile').forEach(function(t) { t.remove(); });
  }

  function applyLayout(items, grid) {
    removeClientTiles(grid);
    Array.prototype.slice.call(grid.querySelectorAll('.item:not(.tile)')).forEach(function(el) {
      el.style.order = '';
      el.style.display = 'none';
      el.style.gridColumn = '';
      el.style.gridRow = '';
    });
    var layout = mosaicLayout(items.map(function(el) {
      return { poids: el.dataset.poids, el: el };
    }));
    layout.forEach(function(entry, i) {
      if (entry._tile) {
        var tile = document.createElement('div');
        tile.className = 'item tile client-tile span-' + entry.span;
        tile.style.cssText = 'background:' + entry.color + ';order:' + i;
        if (entry._row2) tile.style.gridRow = 'span 2';
        grid.appendChild(tile);
      } else {
        entry.el.style.display = '';
        entry.el.style.order = i;
        if (entry._heroSpan) {
          entry.el.style.gridColumn = 'span ' + entry._heroSpan;
          entry.el.style.gridRow = 'span 2';
        }
      }
    });
  }

  function restoreServerLayout() {
    allYearBlocks().forEach(function(block) {
      block.style.display = '';
      var g = block.querySelector('.grid');
      removeClientTiles(g);
      g.querySelectorAll('.item:not(.tile)').forEach(function(el) {
        el.style.display = ''; el.style.order = ''; el.style.gridColumn = ''; el.style.gridRow = '';
      });
      g.querySelectorAll('.server-tile').forEach(function(t) {
        t.style.display = ''; t.style.order = '';
      });
    });
  }

  function restoreFromSelectionFlat() {
    var sfg = wrapper.querySelector('.selection-flat-grid');
    var sfw = wrapper.querySelector('.selection-flat-wrapper');
    if (!sfw || sfw.style.display === 'none') return;
    var items = Array.prototype.slice.call(sfg.querySelectorAll('.item:not(.tile)')).reverse();
    items.forEach(function(el) {
      var p = el._restoreParent, next = el._restoreNext;
      el.style.order = ''; el.style.gridColumn = ''; el.style.gridRow = ''; el.style.display = ''; el.classList.remove('sf-hero');
      if (p) {
        if (next && next.parentNode === p) { p.insertBefore(el, next); } else { p.appendChild(el); }
        el._restoreParent = null; el._restoreNext = null;
      }
    });
    removeClientTiles(sfg);
    sfw.style.display = 'none';
    allYearBlocks().forEach(function(block) { block.style.display = ''; });
  }

  function applySelectionFlatLayout() {
    restoreFromSelectionFlat();
    var sfg = wrapper.querySelector('.selection-flat-grid');
    var sfw = wrapper.querySelector('.selection-flat-wrapper');
    var selectionItems = [];
    allYearBlocks().forEach(function(block) {
      block.style.display = 'none';
      var g = block.querySelector('.grid');
      Array.prototype.slice.call(g.querySelectorAll('.item:not(.tile)')).forEach(function(el) {
        if ((el.getAttribute('data-cats') || '').split(',').indexOf('selection') !== -1) {
          el._restoreParent = g; el._restoreNext = el.nextSibling;
          selectionItems.push(el);
        }
      });
    });
    removeClientTiles(sfg);
    selectionItems.forEach(function(el) {
      el.style.display = 'none'; el.style.order = ''; el.style.gridColumn = ''; el.style.gridRow = '';
      sfg.appendChild(el);
    });
    // Shuffle for visual variety on each filter activation
    var sfItems = selectionItems.slice();
    for (var si = sfItems.length - 1; si > 0; si--) {
      var sj = Math.floor(Math.random() * (si + 1));
      var stmp = sfItems[si]; sfItems[si] = sfItems[sj]; sfItems[sj] = stmp;
    }
    var sfOrder = 0, sfIdx = 0, sfTc1 = -1, sfTc2 = -1;
    var mkSfTile = function(span, row2) {
      var idx;
      do { idx = Math.floor(Math.random() * PALETTE.length); }
      while (idx === sfTc1 || (PALETTE.length > 2 && idx === sfTc2));
      sfTc2 = sfTc1; sfTc1 = idx;
      var t = document.createElement('div');
      t.className = 'item tile client-tile span-' + span;
      t.style.cssText = 'background:' + PALETTE[idx] + ';order:' + String(sfOrder++);
      if (row2) t.style.gridRow = 'span 2';
      sfg.appendChild(t);
    };
    var placeNext = function(span, row2) {
      if (sfIdx >= sfItems.length) { mkSfTile(span, row2); return null; }
      var el = sfItems[sfIdx++];
      el.style.display = ''; el.style.order = String(sfOrder++);
      el.style.gridColumn = 'span ' + span;
      el.style.gridRow = row2 ? 'span 2' : 'span 1';
      return el;
    };
    // Hero forced to row 0 or 1 (max)
    var sfRowCount   = Math.floor(sfItems.length / 2);
    var sfHeroPos    = sfRowCount > 0 ? Math.floor(Math.random() * Math.min(2, sfRowCount)) : -1;
    var sfRowIdx         = 0;
    var sfLastPat        = '';  // anti-consecutive: trio, quadroA, quadroB all block each other
    var sfLastTileP      = -1;  // last trio tile position (0=left,1=mid,2=right)
    var sfLastColorRight = false; // true when last row ended with span-4 color at right (cols 9-12)
    while (sfIdx < sfItems.length) {
      var sfRem = sfItems.length - sfIdx;
      if (sfRem === 1) {
        // Last lone item: flanked by 2 color tiles
        mkSfTile(3, false); placeNext(6, false); mkSfTile(3, false);
      } else {
        if (sfRowIdx === sfHeroPos) {
          // HERO (unique per layout): span-8 × 2 rows + 1 real span-4 + 1 forced color tile
          // If prev row had span-4 color at right, avoid hero color at top-right (would stack same-size)
          var heroColorFirst = sfLastColorRight ? false : Math.random() < 0.5;
          var heroEl = placeNext(8, true);
          if (heroEl) heroEl.classList.add('sf-hero');
          if (heroColorFirst) { mkSfTile(4, false); placeNext(4, false); sfLastColorRight = false; }
          else                { placeNext(4, false); mkSfTile(4, false); sfLastColorRight = true; }
          sfLastPat = 'hero';
        } else {
          var sfR = Math.random();
          var sfIsQuadro = sfLastPat === 'quadroA' || sfLastPat === 'quadroB';
          var sfPat;
          if (sfLastPat === 'trio') {
            // after trio: no trio
            sfPat = sfR < 0.30 ? 'duo' : sfR < 0.55 ? 'mixte' : sfR < 0.77 ? 'quadroA' : 'quadroB';
          } else if (sfIsQuadro) {
            // after any quadro: no quadro of any kind
            sfPat = sfR < 0.35 ? 'duo' : sfR < 0.65 ? 'trio' : 'mixte';
          } else {
            sfPat = sfR < 0.22 ? 'duo' : sfR < 0.42 ? 'trio' : sfR < 0.62 ? 'mixte' : sfR < 0.81 ? 'quadroA' : 'quadroB';
          }
          if (sfPat === 'duo') {
            // DUO: 6+6, no tile
            placeNext(6, false); placeNext(6, false);
            sfLastColorRight = false;
          } else if (sfPat === 'trio') {
            // TRIO: tile at random position, never same as previous trio, never right if prev was right
            var tp;
            do { tp = Math.floor(Math.random() * 3); } while (tp === sfLastTileP || (sfLastColorRight && tp === 2));
            sfLastTileP = tp;
            if      (tp === 0) { mkSfTile(4, false); placeNext(4, false); placeNext(4, false); sfLastColorRight = false; }
            else if (tp === 1) { placeNext(4, false); mkSfTile(4, false); placeNext(4, false); sfLastColorRight = false; }
            else               { placeNext(4, false); placeNext(4, false); mkSfTile(4, false); sfLastColorRight = true; }
          } else if (sfPat === 'mixte') {
            // MIXTE: [tile-3] + 6 + 3  or  3 + 6 + [tile-3] — span-3 ≠ span-4, no edge conflict
            if (Math.random() < 0.5) { mkSfTile(3, false); placeNext(6, false); placeNext(3, false); }
            else                     { placeNext(3, false); placeNext(6, false); mkSfTile(3, false); }
            sfLastColorRight = false;
          } else if (sfPat === 'quadroA') {
            // QUADRO A: tile-2 + item-4 + tile-2 + item-4 — right edge is a project item
            mkSfTile(2, false); placeNext(4, false); mkSfTile(2, false); placeNext(4, false);
            sfLastColorRight = false;
          } else {
            // QUADRO B: item-4 + tile-2 + item-4 + tile-2 — right edge is span-2, different size
            placeNext(4, false); mkSfTile(2, false); placeNext(4, false); mkSfTile(2, false);
            sfLastColorRight = false;
          }
          sfLastPat = sfPat;
        }
        sfRowIdx++;
      }
    }
    sfw.style.display = 'block';
  }

  var _filterTimer = null;
  var _cleanupTimer = null;

  function cancelPending() {
    if (_filterTimer)  { clearTimeout(_filterTimer);  _filterTimer  = null; }
    if (_cleanupTimer) { clearTimeout(_cleanupTimer); _cleanupTimer = null; }
    projectItems().forEach(function(el) { el.style.transition = 'none'; el.style.opacity = ''; });
    wrapper.querySelectorAll('.client-tile, .server-tile').forEach(function(t) {
      t.style.transition = 'none'; t.style.opacity = '';
    });
    wrapper.querySelectorAll('.year-sep').forEach(function(sep) { sep.style.transition = 'none'; sep.style.opacity = ''; sep.style.display = ''; });
    var gc = wrapper.querySelector('.global-clients');
    if (gc) { gc.style.transition = 'none'; gc.style.opacity = ''; gc.style.display = ''; }
  }

  function byPosition(els) {
    return els.map(function(el) {
      var r = el.getBoundingClientRect();
      return { el: el, top: r.top, left: r.left };
    }).sort(function(a, b) { return a.top !== b.top ? a.top - b.top : a.left - b.left; });
  }

  function applyPerYear(cat) {
    if (cat === 'selection') { applySelectionFlatLayout(); return; }
    allYearBlocks().forEach(function(block) {
      var g = block.querySelector('.grid');
      var blockItems = Array.prototype.slice.call(g.querySelectorAll('.item:not(.tile)'));
      var visible = blockItems.filter(function(el) {
        return (el.getAttribute('data-cats') || '').split(',').indexOf(cat) !== -1;
      });
      if (visible.length === 0) {
        block.style.display = 'none';
      } else {
        block.style.display = '';
        g.querySelectorAll('.server-tile').forEach(function(t) { t.style.display = 'none'; });
        applyLayout(visible, g);
      }
    });
  }

  function applyFilter(cat, animate) {
    filterBtns.forEach(function(btn) {
      btn.classList.toggle('active', btn.getAttribute('data-cat') === cat);
    });

    var wasSelection = wrapper.classList.contains('mode-selection');
    var willBeSelection = cat === 'selection';

    if (!animate) {
      if (wasSelection && !willBeSelection) { restoreFromSelectionFlat(); }
      wrapper.classList.toggle('mode-selection', willBeSelection);
      if (willBeSelection) {
        wrapper.querySelectorAll('.global-clients .sep-track').forEach(function(t) { t.style.animation = 'none'; });
        wrapper.querySelector('.global-clients .sep-track') && wrapper.querySelector('.global-clients .sep-track').getBoundingClientRect();
        wrapper.querySelectorAll('.global-clients .sep-track').forEach(function(t) { t.style.animation = ''; });
      }
      if (cat === '') { restoreServerLayout(); }
      else { applyPerYear(cat); }
      history.pushState({ cat: cat }, '', cat ? PAGEBASE + '?cat=' + cat : PAGEBASE);
      return;
    }

    cancelPending();

    var allProjects = projectItems();
    var FADE = 280, FADE_IN = 600, STAGGER = 40, MAX_SPREAD = 360;

    var fadeOutEls = allProjects.filter(function(el) { return el.style.display !== 'none'; });
    wrapper.querySelectorAll('.client-tile, .server-tile').forEach(function(t) {
      if (t.style.display !== 'none') fadeOutEls.push(t);
    });
    // Going TO selection: fade out visible year-seps
    if (!wasSelection && willBeSelection) {
      wrapper.querySelectorAll('.year-sep').forEach(function(sep) {
        var block = sep.closest('.year-block');
        if (block && block.style.display !== 'none') fadeOutEls.push(sep);
      });
    }
    // Going FROM selection: fade out global-clients
    if (wasSelection && !willBeSelection) {
      var gcOut = wrapper.querySelector('.global-clients');
      if (gcOut) fadeOutEls.push(gcOut);
    }
    var outSorted = byPosition(fadeOutEls);
    var nOut = outSorted.length;
    var outSpread = nOut > 1 ? Math.min((nOut - 1) * STAGGER, MAX_SPREAD) : 0;
    outSorted.forEach(function(item, i) {
      var d = nOut > 1 ? Math.round(i / (nOut - 1) * outSpread) : 0;
      item.el.style.transition = 'opacity ' + FADE + 'ms ' + d + 'ms';
      item.el.style.opacity = '0';
    });

    _filterTimer = setTimeout(function() {
      _filterTimer = null;
      // Restore flat grid items first so year-blocks are populated before pre-show
      if (wasSelection && !willBeSelection) { restoreFromSelectionFlat(); }
      // Pre-show year-seps at opacity 0 before class toggle (going FROM selection)
      if (wasSelection && !willBeSelection) {
        wrapper.querySelectorAll('.year-sep').forEach(function(sep) {
          sep.style.display = 'flex'; sep.style.opacity = '0'; sep.style.transition = '';
        });
      }
      // Pre-show global-clients at opacity 0 before class toggle (going TO selection)
      if (!wasSelection && willBeSelection) {
        var gcPre = wrapper.querySelector('.global-clients');
        if (gcPre) { gcPre.style.display = 'block'; gcPre.style.opacity = '0'; gcPre.style.transition = ''; }
      }
      wrapper.classList.toggle('mode-selection', willBeSelection);
      if (willBeSelection) {
        wrapper.querySelectorAll('.global-clients .sep-track').forEach(function(t) { t.style.animation = 'none'; });
        wrapper.querySelector('.global-clients .sep-track') && wrapper.querySelector('.global-clients .sep-track').getBoundingClientRect();
        wrapper.querySelectorAll('.global-clients .sep-track').forEach(function(t) { t.style.animation = ''; });
      }
      if (cat === '') { restoreServerLayout(); } else { applyPerYear(cat); }
      allProjects.forEach(function(el) { el.style.transition = ''; });
      wrapper.querySelectorAll('.client-tile').forEach(function(t) { t.style.opacity = '0'; t.style.transition = ''; });
      if (cat === '') {
        wrapper.querySelectorAll('.server-tile').forEach(function(t) {
          if (t.style.display !== 'none') { t.style.opacity = '0'; t.style.transition = ''; }
        });
      }

      var fadeInEls = projectItems().filter(function(el) {
        if (el.style.display === 'none') return false;
        var yb = el.closest('.year-block');
        return !yb || yb.style.display !== 'none';
      });
      wrapper.querySelectorAll('.client-tile').forEach(function(t) { fadeInEls.push(t); });
      if (cat === '') {
        wrapper.querySelectorAll('.server-tile').forEach(function(t) {
          if (t.style.display !== 'none') fadeInEls.push(t);
        });
      }
      // Fade in year-seps when going FROM selection (only those in visible blocks)
      if (wasSelection && !willBeSelection) {
        wrapper.querySelectorAll('.year-sep').forEach(function(sep) {
          var block = sep.closest('.year-block');
          if (block && block.style.display !== 'none') fadeInEls.push(sep);
        });
      }
      // Fade in global-clients when going TO selection
      if (!wasSelection && willBeSelection) {
        var gcIn = wrapper.querySelector('.global-clients');
        if (gcIn) fadeInEls.push(gcIn);
      }
      var inSorted = byPosition(fadeInEls);
      var nIn = inSorted.length;
      var inSpread = nIn > 1 ? Math.min((nIn - 1) * STAGGER, MAX_SPREAD) : 0;
      inSorted.forEach(function(item, i) {
        var d = nIn > 1 ? Math.round(i / (nIn - 1) * inSpread) : 0;
        item.el.style.transition = 'opacity ' + FADE_IN + 'ms ' + d + 'ms';
        requestAnimationFrame(function() { item.el.style.opacity = '1'; });
      });
      _cleanupTimer = setTimeout(function() {
        _cleanupTimer = null;
        projectItems().forEach(function(el) { el.style.transition = ''; el.style.opacity = ''; });
        wrapper.querySelectorAll('.client-tile, .server-tile').forEach(function(t) { t.style.transition = ''; t.style.opacity = ''; });
        wrapper.querySelectorAll('.year-sep').forEach(function(sep) { sep.style.transition = ''; sep.style.opacity = ''; sep.style.display = ''; });
        var gcClean = wrapper.querySelector('.global-clients');
        if (gcClean) { gcClean.style.transition = ''; gcClean.style.opacity = ''; gcClean.style.display = ''; }
      }, inSpread + FADE_IN + 150);

    }, outSpread + FADE + 10);

    history.pushState({ cat: cat }, '', cat ? PAGEBASE + '?cat=' + cat : PAGEBASE);
  }

  filterBtns.forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      applyFilter(btn.getAttribute('data-cat'), true);
    });
  });

  var hasSelection = Array.prototype.some.call(filterBtns, function(btn) {
    return btn.getAttribute('data-cat') === 'selection';
  });
  var params = new URLSearchParams(location.search);
  var initial = params.has('cat') ? (params.get('cat') || '') : (hasSelection ? 'selection' : '');
  if (initial) applyFilter(initial, false);

  window.addEventListener('popstate', function(e) {
    applyFilter((e.state && e.state.cat) || '', false);
  });

})();

(function() {
  var btn = document.getElementById('back-top');
  window.addEventListener('scroll', function() {
    btn.classList.toggle('visible', window.scrollY > 500);
  }, { passive: true });
  btn.addEventListener('click', function() {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
})();

(function() {
  var isTouch = window.matchMedia('(hover: none)').matches;
  var videos = Array.prototype.slice.call(document.querySelectorAll('.item video'));
  if (!videos.length) return;

  // iOS limite le nombre de decodeurs video simultanes : au-dela, play() echoue
  // silencieusement et la vignette reste noire. On plafonne les lectures concurrentes.
  var MAX_CONCURRENT = isTouch ? 2 : 4;
  var playing = [];

  function attachSource(video) {
    if (video.dataset.loaded) return;
    video.dataset.loaded = '1';
    video.src = video.dataset.src;
    video.load();
  }

  function reveal(video) {
    video.style.opacity = '1';
  }

  function hide(video) {
    video.style.opacity = '0';
  }

  function stop(video) {
    var i = playing.indexOf(video);
    if (i !== -1) playing.splice(i, 1);
    hide(video);
    video.pause();
    try { video.currentTime = 0; } catch (e) {}
  }

  function start(video) {
    if (playing.indexOf(video) !== -1) return;
    while (playing.length >= MAX_CONCURRENT) stop(playing[0]);
    playing.push(video);

    attachSource(video);

    // Le listener doit etre pose AVANT play() : si iOS refuse la lecture,
    // l'evenement n'arrive jamais et on ne doit surtout pas devoiler un element vide.
    var onPlaying = function () {
      video.removeEventListener('playing', onPlaying);
      if (playing.indexOf(video) !== -1 && video.readyState >= 2) reveal(video);
    };
    video.addEventListener('playing', onPlaying);

    var p = video.play();
    if (p && p.catch) p.catch(function () { stop(video); });
  }

  if (isTouch) {
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) start(entry.target);
        else stop(entry.target);
      });
    }, { threshold: 0.6 });

    videos.forEach(function (video) { observer.observe(video); });
  } else {
    // Sur desktop, on precharge la source au survol imminent pour eviter le trou noir.
    videos.forEach(function (video) {
      var item = video.closest('.item');
      var leaveTimer = null;

      item.addEventListener('mouseenter', function () {
        if (leaveTimer) { clearTimeout(leaveTimer); leaveTimer = null; }
        start(video);
      });

      item.addEventListener('mouseleave', function () {
        hide(video);
        leaveTimer = setTimeout(function () {
          leaveTimer = null;
          stop(video);
        }, 400);
      });
    });
  }
})();

</script>

</BaseLayout>

