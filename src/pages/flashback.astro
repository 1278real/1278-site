---
const base = import.meta.env.BASE_URL;

const timeline = [
  {
    annee: '2000',
    titre: 'Diplômé 3IS',
    texte: 'Spécialité montage & effets visuels. Débuts en tant que monteur sur <em>Tout le monde en parle</em>, <em>Paris Dernière</em>, <em>Le Soldat Rose</em>…',
  },
  {
    annee: '2005',
    titre: 'Création FADE IN',
    texte: 'Société d\'habillage TV et graphismes. Truquiste sur <em>Ça se discute</em>, <em>Miss France</em>, <em>Roland Garros</em>, le Festival de Cannes, la Ligue 1, le Top 14 et la Coupe du Monde de la FIFA.',
  },
  {
    annee: '2010',
    titre: 'Réalisateur',
    texte: 'Mise en place et réalisation, plateaux et extérieurs, talk et sports. Un credo : mettre à profit les connaissances techniques acquises & les collaborations passées pour servir les projets actuels.',
  },
  {
    annee: '2016',
    titre: 'Création 27|28 réalisation(s)',
    texte: 'Structure dédiée à la réalisation TV & au développement iOS / Android.',
  },
  {
    annee: '2019',
    titre: '1·2·7·8 réalisation(s)',
    texte: 'Fade In & 27|28 réalisation(s) fusionnent. La structure unique porte désormais l\'ensemble des activités : réalisation TV, mise en place artistique et développement applicatif.',
  },
];
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Flashback · 1·2·7·8 réalisation(s)</title>
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml">
  <link rel="icon" href={`${base}favicon.ico`} sizes="any">
  <link rel="stylesheet" href="https://use.typekit.net/deq5imu.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>

<nav>
  <a href={base} class="logo">
    <img src={`${base}logo.png`} class="logo-mark" alt="1·2·7·8 réalisation(s)" onerror="this.style.display='none';this.parentElement.querySelector('.logo-fallback').style.display='flex'">
    <span class="logo-fallback" style="display:none"><span class="logo-text">1<span class="accent">·</span>2<span class="accent">·</span>7<span class="accent">·</span>8</span><span class="logo-sub"> réalisation(s)</span></span>
  </a>
  <div class="links">
    <a href={base}>Portfolio</a>
    <a href={`${base}flashback`} class="active">Flashback</a>
    <a href={`${base}contact`}>Contact</a>
    <a href={`${base}en`}>EN</a>
  </div>
</nav>

<div class="page-header">
  <h1>Flashback</h1>
  <p class="subtitle">Avant de créer 1·2·7·8 réalisation(s)…</p>
</div>

<div class="timeline">
  {timeline.map((entry, i) => (
    <div class={`entry ${i % 2 === 0 ? 'left' : 'right'}`}>
      <div class="entry-content">
        <span class="annee">{entry.annee}</span>
        <h2>{entry.titre}</h2>
        <p set:html={entry.texte} />
      </div>
      <div class="dot"></div>
    </div>
  ))}
</div>

<footer>
  <span>1·2·7·8 réalisation(s)</span>
  <span>contact@1-2-7-8.tv · +33 (0)6 44 66 33 00</span>
</footer>

</body>
</html>

<style is:global>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: #0a0a0a; color: #e8e8e0; font-family: 'Barlow Condensed', sans-serif; min-height: 100vh; display: flex; flex-direction: column; }

  nav { display: flex; justify-content: space-between; align-items: center; padding: 16px 24px; border-bottom: 0.5px solid rgba(13,102,127,0.35); }
  .logo { font-size: 14px; font-weight: 700; letter-spacing: .08em; text-decoration: none; color: inherit; display: flex; align-items: center; gap: 8px; }
  .logo-mark { height: 28px; width: auto; }
  .logo-text { font-family: 'stenciletta-solid', 'Barlow Condensed', sans-serif; }
  .logo .accent { color: #1CC9FE; }
  .logo-sub { font-weight: 400; color: #7D8893; }
  nav .links { display: flex; gap: 20px; }
  nav a { font-size: 11px; color: #7D8893; text-decoration: none; letter-spacing: .1em; font-family: 'stenciletta-solid', 'Barlow Condensed', sans-serif; }
  nav a.active { color: #1CC9FE; }

  .page-header { padding: 48px 24px 0; text-align: center; }
  .page-header h1 { font-size: 56px; font-weight: 700; font-family: 'stenciletta-solid', 'Barlow Condensed', sans-serif; letter-spacing: .04em; }
  .subtitle { font-size: 13px; color: #7D8893; margin-top: 8px; letter-spacing: .08em; }

  /* Timeline */
  .timeline { flex: 1; position: relative; max-width: 900px; margin: 60px auto; padding: 0 24px 60px; width: 100%; }

  /* Ligne verticale centrale */
  .timeline::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0; bottom: 0;
    width: 0.5px;
    background: linear-gradient(to bottom, transparent, rgba(28,201,254,0.3) 10%, rgba(28,201,254,0.3) 90%, transparent);
    transform: translateX(-50%);
  }

  .entry { display: flex; align-items: flex-start; position: relative; margin-bottom: 60px; }
  .entry.left { flex-direction: row-reverse; }
  .entry.right { flex-direction: row; }

  .entry-content {
    width: calc(50% - 28px);
    background: rgba(255,255,255,0.03);
    border: 0.5px solid rgba(255,255,255,0.08);
    padding: 20px 24px;
  }
  .entry.left .entry-content { margin-right: 28px; text-align: right; }
  .entry.right .entry-content { margin-left: 28px; }

  .annee { font-size: 11px; color: #1CC9FE; letter-spacing: .12em; font-weight: 700; }
  .entry-content h2 { font-size: 22px; font-weight: 700; font-family: 'stenciletta-solid', 'Barlow Condensed', sans-serif; margin-top: 4px; letter-spacing: .04em; line-height: 1.1; }
  .entry-content p { font-size: 14px; color: #7D8893; margin-top: 10px; line-height: 1.6; }
  .entry-content p em { color: #e8e8e0; font-style: normal; }

  .dot {
    position: absolute;
    left: 50%;
    top: 20px;
    width: 10px; height: 10px;
    background: #1CC9FE;
    border-radius: 50%;
    transform: translateX(-50%);
    flex-shrink: 0;
  }

  footer { background: #0D667F; padding: 10px 24px; display: flex; justify-content: space-between; margin-top: auto; }
  footer span { font-size: 10px; color: rgba(255,255,255,0.7); }

  @media (max-width: 640px) {
    nav { padding: 12px 16px; flex-wrap: wrap; gap: 8px; }
    nav .links { gap: 14px; }

    .page-header { padding: 32px 16px 0; }
    .page-header h1 { font-size: 36px; }

    .timeline { padding: 0 16px 40px; margin-top: 40px; }
    .timeline::before { left: 16px; }

    .entry.left, .entry.right { flex-direction: row; }
    .entry-content { width: calc(100% - 44px); margin-left: 44px !important; margin-right: 0 !important; text-align: left !important; }
    .dot { left: 16px; top: 20px; }
  }
</style>
